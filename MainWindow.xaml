<Window x:Class="Assign_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <!-- LOGIN SCREEN -->
        <StackPanel x:Name="LoginScreen" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <TextBlock Text="Login" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
            <TextBox x:Name="UsernameBox" Height="25" Margin="0,0,0,10"/>
            <PasswordBox x:Name="PasswordBox" Height="25" Margin="0,0,0,15"/>
            <Button Content="Sign In" Height="30" Click="LoginButton_Click"/>
        </StackPanel>

        <!-- ADMIN VIEW (BLANK) -->
        <StackPanel x:Name="AdminScreen" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="This is the Admin View" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <Button Content="Logout" Width="100" Height="30" Click="LogoutButton_Click"/>
        </StackPanel>

        <!-- GUEST VIEW (BLANK) -->
        <StackPanel x:Name="GuestScreen" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="This is the Guest View" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <Button Content="Logout" Width="100" Height="30" Click="LogoutButton_Click"/>
        </StackPanel>

    </Grid>
</Window>