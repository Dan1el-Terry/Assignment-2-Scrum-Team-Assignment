<Window x:Class="Assign_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <!-- LOGIN SCREEN -->
        <StackPanel x:Name="LoginScreen" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <TextBlock Text="Login" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
            <TextBox x:Name="UsernameBox" Height="25" Margin="0,0,0,10"/>
            <PasswordBox x:Name="PasswordBox" Height="25" Margin="0,0,0,15"/>
            <Button Content="Sign In" Height="30" Click="LoginButton_Click"/>
        </StackPanel>

        <!-- ADMIN VIEW -->
        <Grid x:Name="AdminScreen" Visibility="Collapsed" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="UsersGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      SelectionChanged="UsersGrid_SelectionChanged"
                      IsReadOnly="True"
                      Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="200" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
<!--The rest of the admin stuff is AI cause Xaml hates me though should be simple to change-->
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Username:" Width="80" VerticalAlignment="Center" />
                    <TextBox x:Name="EditUsernameBox" Width="180" Margin="0,0,15,0" />

                    <TextBlock Text="Role:" Width="40" VerticalAlignment="Center" />
                    <ComboBox x:Name="RoleBox" Width="120">
                        <ComboBoxItem Content="Admin" />
                        <ComboBoxItem Content="User" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="New Password:" Width="80" VerticalAlignment="Center" />
                    <PasswordBox x:Name="NewPasswordBox" Width="180" Margin="0,0,15,0" />
                    <Button Content="Reset Password" Click="ResetPassword_Click" Width="120" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save Changes" Click="SaveChanges_Click" Width="110" Margin="0,0,10,0" />
                    <Button Content="Delete User" Click="DeleteUser_Click" Width="110" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Add New User" Width="110" Margin="0,0,10,0" Click="ShowNewUserScreen_Click"/>
                <Button Content="Logout" Width="100" Click="LogoutButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- NEW USER VIEW -->
        <StackPanel x:Name="NewUserScreen" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Create User Below" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBox x:Name="NewUsername" Height="25" Margin="0,0,0,10"/>
            <PasswordBox x:Name="NewPassword" Height="25" Margin="0,0,0,10"/>
            <ComboBox x:Name="NewRole" Height="25" Margin="0,0,0,10">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="User"/>
            </ComboBox>
            <Button Content="Register New User" Width="100" Height="30" Click="RegisterButton_Click"/>
            <Button Content="Return" Width="100" Height="30" Click="ReturnButton_Click"/>
        </StackPanel>

        <!-- USER VIEW -->
        <StackPanel x:Name="UserScreen" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="This is the User View" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <Button Content="Logout" Width="100" Height="30" Click="LogoutButton_Click"/>
        </StackPanel>

    </Grid>
</Window>